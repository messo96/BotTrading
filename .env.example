# Inserisci il token fornito da @BotFather su Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# (Opzionale) Inserisci il tuo chat_id per ricevere i report automatici personali
# Se non lo conosci, avvia il bot e digita /chatid, poi incollalo qui
TELEGRAM_CHAT_ID=your_chat_id_here

# ID del Gruppo Telegram in cui inviare gli aggiornamenti del portafoglio
# Nota: Aggiungi il bot come membro o amministratore nel gruppo!
TELEGRAM_GROUP_ID=-1004376834480

# Intervallo in ore tra gli aggiornamenti periodici del portafoglio nel gruppo (Default: 2)
PORTFOLIO_UPDATE_INTERVAL_HOURS=2

# Fuso orario per gli orari dei report (Default: Europe/Rome)
TIMEZONE=Europe/Rome

# Orario del report mattutino (formato HH:MM, default 08:30)
# Copre mercati Europei (Piazza Affari prima dell'apertura 09:00), Commodities e Crypto
MORNING_BRIEFING_TIME=08:30

# Orario del report pomeridiano (formato HH:MM, default 15:00)
# Copre pre-market USA prima dell'apertura di Wall Street (15:30) e Indici Futures
AFTERNOON_BRIEFING_TIME=15:00
